# ═══════════════════════════════════════════════════════════════════════════
# docsign-custom — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
#
# Bu dosyayı .env.production olarak kopyala ve aşağıdaki değerleri doldur:
#   cp .env.production.example .env.production
#   nano .env.production
#
# ÖNEMLİ: .env.production dosyası SECRET'lar içerir. Asla git'e commit etme!
# (.gitignore'da zaten ekli olmalı.)
#
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# 1) UYGULAMA TEMEL
# ───────────────────────────────────────────────────────────────────────────

# Uygulamanın çalışacağı domain (TLS sertifikası bu domain için alınacak)
# Örnek: imza.musteri.com.tr
HOST=imza.musteri.com.tr

# Tüm trafiği HTTPS'e zorla (production'da true olmalı)
FORCE_SSL=true

# Rails ortamı (DEĞİŞTİRME)
RAILS_ENV=production

# ───────────────────────────────────────────────────────────────────────────
# 2) SECRET KEY BASE — Rails session/csrf imzalama anahtarı
# ───────────────────────────────────────────────────────────────────────────
#
# 128 karakter uzunluğunda rastgele bir string olmalı.
# Üretmek için (sunucuda):
#   openssl rand -hex 64
#
# Veya Docker container içinden:
#   docker run --rm ruby:3.3 ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"

SECRET_KEY_BASE=BURAYA_RASTGELE_128_KARAKTER_GELECEK

# ───────────────────────────────────────────────────────────────────────────
# 3) VERİTABANI (PostgreSQL)
# ───────────────────────────────────────────────────────────────────────────
#
# Compose içindeki postgres servisi için varsayılan değerler.
# Production'da güçlü bir parola kullan — `openssl rand -base64 32` ile üretebilirsin.

POSTGRES_USER=docsign
POSTGRES_PASSWORD=GUCLU_PAROLA_BURAYA
POSTGRES_DB=docsign_production

# Uygulamanın DB'ye bağlanması için DATABASE_URL otomatik üretilir:
DATABASE_URL=postgresql://docsign:GUCLU_PAROLA_BURAYA@postgres:5432/docsign_production

# ───────────────────────────────────────────────────────────────────────────
# 4) REDIS (Sidekiq job queue için)
# ───────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379/0

# ───────────────────────────────────────────────────────────────────────────
# 5) SMTP — E-POSTA GÖNDERİMİ (KRİTİK)
# ───────────────────────────────────────────────────────────────────────────
#
# Bu yapılandırma olmadan mail gitmez. Aşağıdaki 4 örnekten birini seç:
#
# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ ÖRNEK A: POSTMARK (önerilen, transactional için en iyisi)              ║
# ╚═══════════════════════════════════════════════════════════════════════╝
# 1. https://postmarkapp.com → hesap aç → Server oluştur
# 2. "Server API Tokens" → token kopyala
# 3. Aşağıdaki değerleri kullan:
#
# SMTP_ADDRESS=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USERNAME=<POSTMARK_SERVER_TOKEN>
# SMTP_PASSWORD=<POSTMARK_SERVER_TOKEN>
# SMTP_DOMAIN=<HOST_DEĞERİNİ_KOPYALA>
# SMTP_AUTHENTICATION=plain
# SMTP_FROM=noreply@<HOST_DEĞERİNİ_KOPYALA>
#
# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ ÖRNEK B: AWS SES                                                       ║
# ╚═══════════════════════════════════════════════════════════════════════╝
# 1. AWS Console → SES → "Verified identities" → domain'i ekle
# 2. SMTP credentials oluştur → erişim anahtarlarını al
#
# SMTP_ADDRESS=email-smtp.eu-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=<SES_SMTP_USERNAME>
# SMTP_PASSWORD=<SES_SMTP_PASSWORD>
# SMTP_DOMAIN=<HOST>
# SMTP_AUTHENTICATION=plain
# SMTP_FROM=noreply@<HOST>
#
# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ ÖRNEK C: RESEND (modern, free tier var)                                ║
# ╚═══════════════════════════════════════════════════════════════════════╝
# 1. https://resend.com → hesap aç → API key oluştur
# 2. Domain doğrulaması yap (DKIM kayıtları DNS'ine ekle)
#
# SMTP_ADDRESS=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=<RESEND_API_KEY>
# SMTP_DOMAIN=<HOST>
# SMTP_AUTHENTICATION=plain
# SMTP_FROM=noreply@<HOST>
#
# ╔═══════════════════════════════════════════════════════════════════════╗
# ║ ÖRNEK D: OFFICE 365 / EXCHANGE (kurumsal Microsoft 365)                ║
# ╚═══════════════════════════════════════════════════════════════════════╝
# 1. Müşterinin Microsoft 365 admin paneli üzerinden SMTP relay yetkilisi al
# 2. App password oluştur (MFA aktifse şart)
#
# SMTP_ADDRESS=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=<KULLANICI@MUSTERI.COM.TR>
# SMTP_PASSWORD=<APP_PASSWORD>
# SMTP_DOMAIN=musteri.com.tr
# SMTP_AUTHENTICATION=login
# SMTP_FROM=imza@musteri.com.tr
#
# ═══════════════════════════════════════════════════════════════════════════
# Doldurulacak SMTP değerleri (yukarıdaki örneklerden birini kopyala):
# ═══════════════════════════════════════════════════════════════════════════

SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
SMTP_AUTHENTICATION=plain
SMTP_FROM=

# Bağlantı zaman aşımı (saniye)
SMTP_OPEN_TIMEOUT=15
SMTP_READ_TIMEOUT=25

# ───────────────────────────────────────────────────────────────────────────
# 6) OBJECT STORAGE (S3) — OPSIYONEL AMA ÖNERİLEN
# ───────────────────────────────────────────────────────────────────────────
#
# İmzalanmış PDF'ler ve şablon dosyaları için kalıcı depolama.
# Set EDILMEZSE local disk'te (/data/docuseal) tutulur — container restart'ta
# kaybolma riski VAR (volume bind mount düzgün yapılırsa risk yok ama
# disaster recovery için S3 önerilir).
#
# Önerilen sağlayıcılar:
#   • Hetzner Storage Box — €1.20/ay, 10 GB
#   • Backblaze B2 — $0.005/GB/ay
#   • AWS S3 — $0.023/GB/ay
#   • MinIO (self-hosted) — ücretsiz, kendi sunucunda
#
# Boş bırakırsan disk storage kullanılır.

S3_ATTACHMENTS_BUCKET=
S3_ATTACHMENTS_REGION=
S3_ATTACHMENTS_ACCESS_KEY_ID=
S3_ATTACHMENTS_SECRET_ACCESS_KEY=
S3_ATTACHMENTS_ENDPOINT=

# ───────────────────────────────────────────────────────────────────────────
# 7) UYGULAMA AYARLARI
# ───────────────────────────────────────────────────────────────────────────

# Saat dilimi (Türkiye için Europe/Istanbul)
TIME_ZONE=Europe/Istanbul

# Varsayılan dil (Türkçe için 'tr')
DEFAULT_LOCALE=tr

# Maks. mail eklenti boyutu (MB)
MAX_ATTACHMENTS_SIZE_MB=10
