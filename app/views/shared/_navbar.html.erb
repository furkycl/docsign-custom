<%# DOCSIGN-CUSTOM: simplified header. Removed: DocuSeal logo+title, %>
<%# GitHub icon, demo Sign-Up button, Console / Ask AI / Test Mode / %>
<%# Verify-PDF entries from the profile dropdown. Added: primary %>
<%# navigation links (Şablonlar / Gönderimler / Ayarlar). %>
<%= render 'shared/navbar_warning' %>
<div class="max-w-6xl mb-4 mx-auto px-4 md:px-2 py-3 flex items-center justify-between">
  <% if signed_in? %>
    <%# Primary navigation %>
    <nav class="flex items-center space-x-2 md:space-x-6">
      <% nav_link_classes = 'font-medium text-base md:text-lg px-2 py-1 rounded hover:bg-base-200 whitespace-nowrap' %>
      <% active_link_classes = 'font-semibold text-base md:text-lg px-2 py-1 rounded bg-base-200 whitespace-nowrap' %>

      <% on_templates = request.path == root_path || request.path.start_with?('/templates') %>
      <%= link_to root_path, class: on_templates ? active_link_classes : nav_link_classes do %>
        <span class="flex items-center space-x-1">
          <%= svg_icon('file_text', class: 'w-5 h-5 hidden sm:inline') %>
          <span><%= t('templates') %></span>
        </span>
      <% end %>

      <% on_submissions = request.path.start_with?('/submissions') %>
      <%= link_to submissions_path, class: on_submissions ? active_link_classes : nav_link_classes do %>
        <span class="flex items-center space-x-1">
          <%= svg_icon('send', class: 'w-5 h-5 hidden sm:inline') %>
          <span><%= t('submissions') %></span>
        </span>
      <% end %>

      <% on_settings = request.path.start_with?('/settings') %>
      <%= link_to settings_profile_index_path, class: on_settings ? active_link_classes : nav_link_classes do %>
        <span class="flex items-center space-x-1">
          <%= svg_icon('adjustments', class: 'w-5 h-5 hidden sm:inline') %>
          <span><%= t('settings') %></span>
        </span>
      <% end %>
    </nav>

    <%# User menu %>
    <div class="flex items-center">
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="cursor-pointer bg-base-content text-purple-300 rounded-full p-2 w-9 justify-center flex">
          <span class="text-sm align-text-top"><%= current_user.initials %></span>
        </label>
        <ul tabindex="0" class="z-10 dropdown-content p-2 mt-2 shadow menu text-base bg-base-100 rounded-box min-w-[160px] text-right">
          <li>
            <%= link_to settings_profile_index_path, class: 'flex items-center' do %>
              <%= svg_icon('user', class: 'w-5 h-5 flex-shrink-0 stroke-2') %>
              <span class="mr-1"><%= t('profile') %></span>
            <% end %>
          </li>
          <li>
            <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false }, class: 'flex items-center' do %>
              <%= svg_icon('logout', class: 'w-5 h-5 flex-shrink-0 stroke-2 mr-2 inline') %>
              <span class="mr-1 whitespace-nowrap"><%= t('sign_out') %></span>
            <% end %>
          </li>
        </ul>
      </div>
    </div>
  <% else %>
    <%# Logged out: show sign-in link if not already on the sign-in page %>
    <div class="flex-grow"></div>
    <div class="flex space-x-2">
      <% if request.path != new_user_session_path && request.path != setup_index_path %>
        <%= link_to new_user_session_path({ lang: params[:lang] }.compact_blank), class: 'font-medium text-lg' do %>
          <span class="flex items-center justify-center space-x-1">
            <%= svg_icon('login', class: 'w-6 h-6') %>
            <span><%= t('sign_in') %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
