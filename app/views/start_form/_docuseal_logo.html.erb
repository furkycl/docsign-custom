<%# DOCSIGN-CUSTOM: brand-aware start-form logo. %>
<%# Mirrors submit_form/_docuseal_logo.html.erb behavior. If the submitter %>
<%# is associated with a brand, show that brand's logo/name; otherwise render nothing. %>
<% brand = local_assigns[:brand] || (@submitter && @submitter.submission.brand) %>
<% if brand.present? %>
  <div class="flex justify-center items-center">
    <% logo_path = brand.logo_asset_path %>
    <% if logo_path.present? %>
      <%= image_tag logo_path, alt: brand.name, style: 'max-height: 60px; height: auto; width: auto;' %>
    <% else %>
      <h1 class="text-5xl font-bold text-center" style="color: <%= brand.primary_color %>;"><%= brand.name %></h1>
    <% end %>
  </div>
<% end %>
