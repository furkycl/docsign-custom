<% filter_params = params.permit(Submissions::Filter::ALLOWED_PARAMS).compact_blank %>
<% is_show_tabs = (@pagy.count.nil? || @pagy.count >= 5) || params[:status].present? || filter_params.present? %>
<% if Docuseal.demo? %><%= render 'shared/demo_alert' %><% end %>
<div class="flex justify-between items-center w-full mb-4">
  <%# DOCSIGN-CUSTOM: toggle_view removed — header nav links handle Templates ↔ Submissions switching %>
  <div class="flex items-center flex-grow min-w-0">
    <h1 class="text-2xl truncate md:text-3xl sm:text-4xl font-bold md:block <%= 'hidden' if params[:q].present? %>">
      <%= t('submissions') %>
    </h1>
  </div>
  <div class="flex space-x-2 items-center">
    <% if params[:q].present? || @pagy.pages > 1 || filter_params.present? %>
      <%= render 'shared/search_input' %>
    <% end %>
    <%# DOCSIGN-CUSTOM: always show Archive link in header area (was only at bottom) %>
    <%= link_to submissions_archived_index_path, class: 'flex items-center gap-1 text-sm hover:underline whitespace-nowrap' do %>
      <%= svg_icon('archive', class: 'w-4 h-4') %>
      <span class="hidden md:inline"><%= t('view_archived') %></span>
    <% end %>
  </div>
</div>
<% view_archived_html = capture do %>
  <% if can?(:manage, :countless) || current_account.submissions.where.not(archived_at: nil).exists? %>
    <div>
      <a href="<%= submissions_archived_index_path %>" class="link text-sm"><%= t('view_archived') %></a>
    </div>
  <% end %>
<% end %>
<% if is_show_tabs %>
  <div class="flex items-center flex-col md:flex-row md:flex-wrap gap-2 mb-4">
    <div class="flex items-center md:items-end flex-col md:flex-row gap-2 w-full md:w-fit">
      <a href="<%= url_for(params: request.query_parameters.except('status')) %>" class="<%= params[:status].blank? ? 'border-neutral-700' : 'border-neutral-300' %> flex h-10 px-2 py-1 text-lg items-center justify-between border text-center text-neutral font-semibold rounded-xl w-full md:w-48 hover:border-neutral-600">
        <div class="flex items-center space-x-1">
          <%= svg_icon('list', class: 'w-5 h-5') %>
          <span class="font-normal"><%= t('all') %></span>
        </div>
      </a>
      <a href="<%= url_for(params: request.query_parameters.merge('status' => 'pending')) %>" class="<%= params[:status] == 'pending' ? 'border-neutral-700' : 'border-neutral-300' %> flex h-10 px-2 py-1 text-lg items-center justify-between border text-center text-neutral font-semibold rounded-xl w-full md:w-48 hover:border-neutral-600">
        <div class="flex items-center space-x-1">
          <%= svg_icon('clock', class: 'w-5 h-5') %>
          <span class="font-normal"><%= t('pending') %></span>
        </div>
      </a>
      <a href="<%= url_for(params: request.query_parameters.merge('status' => 'completed')) %>" class="<%= params[:status] == 'completed' ? 'border-neutral-700' : 'border-neutral-300' %> flex h-10 px-2 py-1 text-lg items-center justify-between border text-center text-neutral font-semibold rounded-xl w-full md:w-48 hover:border-neutral-600">
        <div class="flex items-center space-x-1">
          <%= svg_icon('circle_check', class: 'w-5 h-5') %>
          <span class="font-normal"><%= t('completed') %></span>
        </div>
      </a>
    </div>
    <%# DOCSIGN-CUSTOM: removed advanced filters / applied-filters display / bulk actions dropdown %>
    <%# Status tabs above (All / Pending / Completed) are sufficient for internal-tool use. %>
  </div>
<% end %>
<% if @pagy.count.nil? || @pagy.count > 0 %>
  <div class="space-y-4">
    <%= render partial: 'templates/submission', collection: @submissions, locals: { with_template: true } %>
  </div>
<%# DOCSIGN-CUSTOM: empty state — hiç gönderim yokken davet edici karşılama %>
<% elsif params[:q].blank? && params[:status].blank? && filter_params.blank? %>
  <div class="flex flex-col items-center justify-center text-center py-16 px-4">
    <div class="bg-base-200 rounded-full p-6 mb-6">
      <%= svg_icon('send', class: 'w-12 h-12 text-base-content/50') %>
    </div>
    <h2 class="text-2xl font-semibold mb-2"><%= t('no_submissions_yet', default: 'Henüz hiç gönderim yok') %></h2>
    <p class="text-base-content/60 mb-6 max-w-md">
      <%= t('no_submissions_hint', default: 'Şablonlar sayfasından bir şablon seçip alıcıya gönderdiğinde burada listelenecek.') %>
    </p>
    <%= link_to root_path, class: 'btn btn-neutral text-white px-6' do %>
      <%= svg_icon('file_text', class: 'w-5 h-5') %>
      <span><%= t('go_to_templates', default: 'Şablonlara git') %></span>
    <% end %>
  </div>
<% end %>
<% if @submissions.present? || (params[:q].blank? && filter_params.blank?) %>
  <% if @pagy.pages > 1 %>
    <%= render 'shared/pagination', pagy: @pagy, items_name: 'submissions', left_additional_html: view_archived_html %>
  <% else %>
    <div class="mt-2">
      <%= view_archived_html %>
    </div>
  <% end %>
<% elsif params[:q].present? || filter_params.present? %>
  <div class="text-center">
    <div class="mt-16 text-3xl font-semibold">
      <%= t('submissions_not_found') %>
    </div>
  </div>
<% end %>
