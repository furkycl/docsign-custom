<%# DOCSIGN-CUSTOM: brand-aware signer page logo. %>
<%# If the submission has a brand, show its logo + name in brand colors. %>
<%# If no brand, render nothing (internal tool — DocuSeal mention removed). %>
<% brand = local_assigns[:brand] || (@submitter && @submitter.submission.brand) %>
<% if brand.present? %>
  <div class="mx-auto text-2xl md:text-3xl font-bold items-center flex space-x-3">
    <% logo_path = brand.logo_asset_path %>
    <% if logo_path.present? %>
      <%= image_tag logo_path, alt: brand.name, style: 'max-height: 48px; height: auto; width: auto;' %>
    <% else %>
      <span style="color: <%= brand.primary_color %>;"><%= brand.name %></span>
    <% end %>
  </div>
<% end %>
